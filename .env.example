# ============================================================================
# Copy to .env and adjust. docker compose reads .env automatically.
# NEVER commit the real .env (it is git-ignored).
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=voteuser
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=voting

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API ---
API_PORT=4000
DATABASE_URL=postgres://voteuser:change_me_to_a_strong_password@db:5432/voting
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Seeded admin account (created on first boot if it does not exist)
ADMIN_EMAIL=admin@voting.local
ADMIN_PASSWORD=change_me_admin_password

# --- Worker ---
# (worker reads DATABASE_URL and REDIS_URL above)

# --- Frontend build-time ---
# Empty means the frontend calls /api on its own origin (through nginx).
VITE_API_URL=
